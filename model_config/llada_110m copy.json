{
    "architectures": [
      "LLaDAModelLM"
    ],
    "model_type": "llada",
    "transformers_version": "4.47.0.dev0",

    "d_model": 768,
    "n_layers": 12,
    "n_heads": 12,
    "n_kv_heads": 12,
    "mlp_hidden_size": 2560,
    "vocab_size": 50368,
    "embedding_size": 50368,
    "max_sequence_length": 8192,
    "activation_type": "silu",
    "layer_norm_type": "default",
    "layer_norm_with_affine": true,
    "bias_for_layer_norm": false,
    "rms_norm_eps": 1e-05,


    "include_bias": false,
    "include_qkv_bias": false,

    "_comment_attention": "Attention and RoPE settings aligned with Llama",
    "rope": true,
    "rope_theta": 160000.0,
    "rope_full_precision": true,
    "alibi": false,
    "attention_implementation": "flash_attention_2",

    "_comment_dropout": "Dropout rates aligned with Llama",
    "attention_dropout": 0.0,
    "embedding_dropout": 0.0,
    "residual_dropout": 0.1,

    "_comment_initialization": "Initialization scheme aligned with Llama",
    "init_fn": "full_megatron",
    "init_std": 0.02,
    "init_cutoff_factor": 2.0,

    "_comment_misc": "Other settings for encoder-style model aligned with Llama",
    "block_type": "llama",
    "use_cache": false,
    "weight_tying": true,
    "torch_dtype": "float32",
    "block_group_size": 1,
    "init_device": "meta",
    "input_emb_norm": false,
    "scale_logits": false,
    "flash_attention":true
}